# Permiso: copy to .env and fill what you need. Everything is optional in replay mode (npm run demo).
PORT=3066
PUBLIC_URL=http://127.0.0.1:3066

# Reap Agentic Payments (sandbox)
REAP_BASE_URL=https://sg.sandbox.api.reap.global
REAP_API_KEY=
# Enrollment id of a card stored through Reap's hosted page (POST /agentic/enrollments)
DEMO_ENROLLMENT_ID=

# Funder access (console, dashboards, funder MCP) and the access code asked by the MCP's OAuth page
FUNDER_TOKEN=
ACCESS_CODE=

# Any OpenAI-compatible LLM (chat completions). DECISION_MODEL decides exceptions as typed JSON.
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
DECISION_MODEL=gpt-4o-mini

# WhatsApp bridge (bridge/ in this repo)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3037
WHATSAPP_BRIDGE_TOKEN=
FUNDER_WHATSAPP=

# Onchain (Ink Sepolia) and Kwal
INK_RPC_URL=https://rpc-gel-sepolia.inkonchain.com
DEPLOYER_KEY=
CONTRACT_ADDRESS=
KWAL_URL=https://api.sandbox.services.payward.com
KWAL_VAULT=
